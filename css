@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

* { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
body {
    font-family: 'Poppins', sans-serif; color: #62536f;
    background: linear-gradient(135deg, #ffe5f0, #dceaff, #f7e5ff);
    overflow-x: hidden;
}
.glass {
    background: rgba(255,255,255,.35); backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,.7);
    box-shadow: 0 8px 30px rgba(160,120,180,.12);
}
.navbar {
    position: fixed; top: 15px; left: 5%; width: 90%; padding: 15px 30px;
    border-radius: 50px; display: flex; justify-content: space-between;
    align-items: center; z-index: 100;
}
.logo { font-size: 23px; font-weight: 800; color: #e879ae; text-decoration: none; }
.nav-links { display: flex; gap: 25px; }
.nav-links a { text-decoration: none; color: #71627e; font-size: 13px; transition: .3s; }
.nav-links a:hover { color: #ed79ae; }
.nav-button, .main-button {
    display: inline-block; background: linear-gradient(135deg,#f18cbb,#91b9f4);
    color: white; text-decoration: none; padding: 12px 25px; border-radius: 30px;
    border: none; cursor: pointer; transition: .4s; font-family: inherit; font-size: 14px;
}
.nav-button:hover, .main-button:hover {
    transform: translateY(-4px); box-shadow: 0 8px 20px #e9a4cc;
}
.hero { height: 700px; position: relative; overflow: hidden; }
.slides { position: absolute; inset: 0; opacity: 0; transition: opacity 1s ease; }
.slides.active { opacity: 1; }
.slides img { width: 100%; height: 100%; object-fit: cover; }
.hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(90deg,rgba(255,225,239,.94),rgba(210,225,255,.55),transparent);
}
.hero-content { position: absolute; top: 32%; left: 10%; max-width: 530px; animation: muncul 1.2s ease; }
.tag { color: #e57eaf; background: rgba(255,255,255,.7); padding: 8px 18px; border-radius: 30px; font-size: 12px; font-weight: 600; }
.hero h1 { font-size: 53px; line-height: 1.2; margin: 25px 0; color: #79638e; }
.hero h1 span { color: #e77cae; }
.hero-content p { line-height: 1.9; margin-bottom: 30px; font-size: 15px; }
.slider-btn {
    position: absolute; top: 50%; transform: translateY(-50%); border: none;
    background: rgba(255,255,255,.65); color: #d978a9; width: 45px; height: 45px;
    border-radius: 50%; cursor: pointer; font-size: 18px; transition: .3s;
}
.slider-btn:hover { background: #f18cbb; color: white; }
.prev { left: 25px; } .next { right: 25px; }
.dots { position: absolute; bottom: 35px; left: 50%; display: flex; gap: 12px; transform: translateX(-50%); }
.dots span { width: 12px; height: 12px; border-radius: 50%; background: white; cursor: pointer; }
.dots span.active { background: #e879ae; }
.benefits { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; padding: 40px 8%; }
.benefit-card { text-align: center; padding: 25px 10px; border-radius: 25px; transition: .4s; }
.benefit-card:hover { transform: translateY(-10px); background: rgba(255,255,255,.7); }
.benefit-card span { font-size: 35px; }
.benefit-card h3 { font-size: 15px; margin: 10px 0; }
.benefit-card p { font-size: 12px; }
.section { padding: 90px 10%; text-align: center; }
.section h2 { font-size: 35px; margin: 20px 0; color: #8c6f9f; }
.about { display: flex; align-items: center; gap: 55px; text-align: left; }
.about-image, .about-text { flex: 1; }
.about-image img { width: 100%; height: 380px; object-fit: cover; border-radius: 30px; box-shadow: 0 15px 35px #d4a7ca; }
.about-text p { line-height: 2; margin-bottom: 20px; font-size: 14px; }
.subtitle { margin-bottom: 40px; font-size: 14px; }
.service-container { display: grid; grid-template-columns: repeat(3,1fr); gap: 25px; }
.service-card { padding: 15px; border-radius: 25px; transition: .4s; }
.service-card:hover { transform: translateY(-12px) scale(1.02); }
.service-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 18px; }
.service-card h3 { margin: 18px 0 10px; }
.service-card p { font-size: 12px; line-height: 1.8; margin-bottom: 15px; }
.service-card a { color: #e879ae; font-size: 13px; text-decoration: none; font-weight: 600; }
.gallery-container { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 35px; }
.gallery-container img { width: 100%; height: 240px; object-fit: cover; border-radius: 25px; transition: .5s; }
.gallery-container img:hover { transform: scale(1.05); }
.contact-box { max-width: 600px; margin: auto; padding: 45px; border-radius: 30px; }
.contact-box p { font-size: 13px; margin-bottom: 20px; }
form { display: flex; flex-direction: column; gap: 15px; }
form input, form select {
    width: 100%; padding: 15px; border: 1px solid rgba(255,255,255,.8);
    border-radius: 15px; outline: none; background: rgba(255,255,255,.7);
    font-family: inherit; color: #71627e;
}
form input:focus, form select:focus { border-color: #e879ae; }
form button { width: 100%; }
#pesan { margin-top: 20px; color: #d36c9c; font-weight: 600; }
footer { text-align: center; padding: 35px 15px; background: rgba(255,255,255,.4); line-height: 2; }
footer h2 { color: #e879ae; } footer p { font-size: 12px; }
@keyframes muncul {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
}
@media(max-width:768px) {
    .navbar { width: 94%; left: 3%; padding: 12px; }
    .nav-links { display: none; }
    .hero { height: 600px; }
    .hero-content { left: 8%; right: 8%; top: 32%; }
    .hero h1 { font-size: 38px; }
    .benefits { grid-template-columns: repeat(2,1fr); padding: 25px 5%; }
    .about { flex-direction: column; }
    .service-container, .gallery-container { grid-template-columns: 1fr; }
    .section { padding: 65px 6%; }
    .contact-box { padding: 25px; }
    .nav-button { padding: 10px 15px; font-size: 11px; }
}
